// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cursor_shape": "block",
  "buffer_line_height": "comfortable",
  "ui_font_weight": 450.0,
  "buffer_font_family": "BlexMono Nerd Font",
  "terminal": {
    "font_family": "BlexMono Nerd Font"
  },
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "theme": "VSCode Dark Polished",
  "vim_mode": true,
  "ui_font_family": "BlexMono Nerd Font",
  "buffer_font_size": 14.5,
  "buffer_font_weight": 450.0
  // "buffer_font_family": "IBM Plex Mono"
  // "buffer_font_family": "monospace"
}
