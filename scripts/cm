#!/usr/bin/env python3

# python3.11+
import argparse
import json
import os
import pathlib
import sqlite3
import subprocess
import tempfile

cm_path = pathlib.Path.home() / ".local/cm/cm.db"

DELIMITER = "\x1f"


def init(args):
    cm_path.parent.mkdir(parents=True, exist_ok=True)
    with get_db() as db:
        db.execute("""
        CREATE TABLE IF NOT EXISTS shellcommand (
            command TEXT NOT NULL UNIQUE,
            tag TEXT,
            description TEXT
        )
        """)


def get_db() -> sqlite3.Connection:
    db = sqlite3.connect(cm_path)
    db.row_factory = sqlite3.Row
    return db


def open_temp_file(template: dict[str, str] | None = None) -> tuple[str, int]:
    if not template:
        template = {"command": "", "tag": "", "description": ""}
    fd, filename = tempfile.mkstemp(suffix=".json", text=True)
    try:
        with os.fdopen(fd, "w") as _file:
            json.dump(template, _file, indent=4)
        write_status = subprocess.call(["vi", filename])
        return filename, write_status
    except Exception:
        os.unlink(filename)
        raise


def insert(command: dict[str, str]):
    try:
        with get_db() as db:
            db.execute(
                "INSERT INTO shellcommand VALUES(?, ?, ?)",
                (command.get("command"), command.get("tag"), command.get("description")),
            )
    except Exception as err:
        print(f"Exception encountered while saving the command - {err}")


def get_commands() -> list[dict[str, str]]:
    with get_db() as db:
        res = db.execute("SELECT * FROM shellcommand")
        return [dict(x) for x in res]


def select_command(command_list: list[dict[str, str]]) -> str | None:
    fzf_input = []
    command_map = {}
    for command in command_list:
        tag = command.get("tag")
        description = command.get("description")
        entry = f"{command.get('command')}{DELIMITER}{tag}{DELIMITER}{description}"
        fzf_input.append(entry)
        command_map[command.get("command")] = (tag, description)

    fzf_command = ["fzf", "--preview-window=up:20%", f"--delimiter={DELIMITER}", "--with-nth=1", "--preview", "echo -e 'Tag: {2}\nDescription: {3}'"]
    result = subprocess.run(fzf_command, input="\n".join(fzf_input), text=True, capture_output=True)

    if result.returncode == 0 and result.stdout.strip():
        selected_line = result.stdout.strip().split(DELIMITER)[0]
        return selected_line
    return None


def ls(args):
    commands = get_commands()
    selected_command = select_command(commands)
    if selected_command:
        print("\n" + selected_command + "\n")


def new(args):
    filename, write_status = open_temp_file()
    try:
        if write_status != 0:
            print("Editor exited without saving, aborting.")
            return
        with open(filename, "r") as _file:
            result = json.load(_file)
        if not result.get("command"):
            print("No command provided, aborting.")
            return
        insert(result)
    finally:
        os.unlink(filename)


def add(args):
    history_path = pathlib.Path.home() / ".bash_history"
    if not history_path.exists():
        print("No bash history found.")
        return
    result = subprocess.run(
        ["fzf"],
        stdin=history_path.open("r"),
        stdout=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return
    command = result.stdout.strip()
    filename, write_status = open_temp_file({"command": command, "tag": "", "description": ""})
    try:
        if write_status != 0:
            print("Editor exited without saving, aborting.")
            return
        with open(filename, "r") as _file:
            data = json.load(_file)
        insert(data)
    finally:
        os.unlink(filename)


def simulate_typing_macos(command: str):
    escaped = command.replace("\\", "\\\\").replace('"', '\\"')
    script = f'tell application "System Events" to keystroke "{escaped}"'
    subprocess.run(["osascript", "-e", script])


def edit(args):
    commands = get_commands()
    selected_command = select_command(commands)
    # TODO: add edit
    # TODO: also add import/export to JSON


def rm(args):
    commands = get_commands()
    selected_command = select_command(commands)
    if selected_command:
        with get_db() as db:
            db.execute("DELETE from shellcommand WHERE command=?", (selected_command,))


def main():
    parser = argparse.ArgumentParser(
        prog="cm",
        description="Manage your shell commands",
    )

    subparsers = parser.add_subparsers(dest="command")

    sub_new = subparsers.add_parser("n", help="Add a new command")
    sub_new.set_defaults(func=new)

    sub_init = subparsers.add_parser("init", help="Initial setup")
    sub_init.set_defaults(func=init)

    sub_add = subparsers.add_parser("a", help="Add from bash history")
    sub_add.set_defaults(func=add)

    sub_edit = subparsers.add_parser("e", help="Edit/update commands")
    sub_edit.set_defaults(func=edit)

    sub_rm = subparsers.add_parser("r", help="Delete commands")
    sub_rm.set_defaults(func=rm)

    parser.set_defaults(func=ls)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
