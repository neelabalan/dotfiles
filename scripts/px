#!/usr/bin/env python3

"""
px - a tiny multi-language project runner.

Rules it lives by:
  - one flat directory per language, no nested module trees
  - a `.px.json` in the current directory marks where px can run (like a project marker)
  - each language uses its own native tooling: uv (python), pnpm+tsx (js/ts), cargo (rust), go (go)
  - `px new foo.rs` / `px run foo.rs` / `px test foo.rs` just take a filename; px knows
    where it lives because there's exactly one directory per language.
"""

import abc
import argparse
import dataclasses
import json
import pathlib
import subprocess
import sys
import typing

CONFIG_FILENAME = '.px.json'

EXTENSIONS: dict[str, str] = {
    'python': '.py',
    'js': '.js',
    'ts': '.ts',
    'rust': '.rs',
    'go': '.go',
}

GITIGNORE_URLS: dict[str, str] = {
    'python': 'https://raw.githubusercontent.com/github/gitignore/main/Python.gitignore',
    'js': 'https://raw.githubusercontent.com/github/gitignore/main/Node.gitignore',
    'ts': 'https://raw.githubusercontent.com/github/gitignore/main/Node.gitignore',
    'rust': 'https://raw.githubusercontent.com/github/gitignore/main/Rust.gitignore',
    'go': 'https://raw.githubusercontent.com/github/gitignore/main/Go.gitignore',
}

DEFAULT_TEMPLATES: dict[str, tuple[str, str | None]] = {
    'python': (
        'def main():\n    pass\n\n\nif __name__ == \'__main__\':\n    main()\n',
        'def test_main():\n    pass\n',
    ),
    'js': (
        'function main() {\n}\n\nmain();\n',
        "import { test } from 'node:test';\nimport assert from 'node:assert';\n\n"
        "test('example', () => {\n  assert.ok(true);\n});\n",
    ),
    'ts': (
        'function main(): void {\n}\n\nmain();\n',
        "import { test } from 'node:test';\nimport assert from 'node:assert';\n\n"
        "test('example', () => {\n  assert.ok(true);\n});\n",
    ),
    'rust': (
        'fn main() {\n}\n',
        '#[test]\nfn it_works() {\n    assert!(true);\n}\n',
    ),
    'go': (
        'package main\n\nfunc main() {\n}\n',
        'package main\n\nimport "testing"\n\nfunc TestExample(t *testing.T) {\n}\n',
    ),
}


@dataclasses.dataclass
class LanguageEntry:
    dir: str
    source_template: str = ''
    test_template: str | None = None


@dataclasses.dataclass
class Config:
    root: pathlib.Path
    editor: str
    languages: dict[str, LanguageEntry]

    @classmethod
    def sample(cls) -> dict[str, typing.Any]:
        languages = {}
        for lang, ext in EXTENSIONS.items():
            source_template, test_template = DEFAULT_TEMPLATES[lang]
            languages[lang] = {
                'dir': lang,
                'source_template': source_template,
                'test_template': test_template,
            }
        return {'editor': 'code', 'languages': languages}

    @classmethod
    def load(cls, root: pathlib.Path) -> 'Config':
        raw = json.loads((root / CONFIG_FILENAME).read_text())
        editor = raw.get('editor', 'code')
        languages: dict[str, LanguageEntry] = {}

        for lang, entry in raw.get('languages', {}).items():
            if lang not in EXTENSIONS:
                raise ValueError(
                    f"unknown language '{lang}' in {CONFIG_FILENAME}. valid: {', '.join(EXTENSIONS)}"
                )
            dir_name = entry.get('dir')
            if not dir_name or '/' in dir_name or '\\' in dir_name:
                raise ValueError(f"language '{lang}' must have a single flat 'dir' name, got: {dir_name!r}")
            languages[lang] = LanguageEntry(
                dir=dir_name,
                source_template=entry.get('source_template', ''),
                test_template=entry.get('test_template'),
            )

        return cls(root=root, editor=editor, languages=languages)

    def dir_for(self, language: str) -> pathlib.Path:
        return self.root / self.languages[language].dir


def sh(args: list[str], cwd: pathlib.Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(args, cwd=cwd, capture_output=False)


def download_gitignore(language: str, target: pathlib.Path) -> None:
    import urllib.request

    url = GITIGNORE_URLS.get(language)
    if not url:
        return
    try:
        with urllib.request.urlopen(url) as response:
            target.write_text(response.read().decode('utf-8'))
            print(f'created: {target}')
    except Exception as e:
        print(f'warning: failed to download .gitignore for {language}: {e}', file=sys.stderr)


class LanguageHandler(abc.ABC):
    language: str

    def __init__(self, entry: LanguageEntry, directory: pathlib.Path) -> None:
        self.entry = entry
        self.dir = directory

    def test_path_for(self, path: pathlib.Path) -> pathlib.Path:
        return path.parent / f'{path.stem}_test{path.suffix}'

    @abc.abstractmethod
    def init_project(self) -> None: ...

    @abc.abstractmethod
    def create(self, path: pathlib.Path) -> None: ...

    @abc.abstractmethod
    def run(self, path: pathlib.Path) -> subprocess.CompletedProcess: ...

    @abc.abstractmethod
    def test(self, path: pathlib.Path) -> subprocess.CompletedProcess: ...

    @abc.abstractmethod
    def check(self, path: pathlib.Path) -> subprocess.CompletedProcess: ...


class PythonHandler(LanguageHandler):
    language = 'python'

    def init_project(self) -> None:
        pyproject = self.dir / 'pyproject.toml'
        if not pyproject.exists():
            result = subprocess.run(
                ['uv', 'init', '--no-readme', '--vcs', 'none', '--python', '3.11'], cwd=self.dir, capture_output=True
            )
            if result.returncode != 0:
                raise RuntimeError(f'uv init failed: {result.stderr.decode()}')
            print(f'initialized uv project: {self.dir}')

            main_py = self.dir / 'main.py'
            if main_py.exists():
                main_py.unlink()

            content = pyproject.read_text()
            content += '\n[tool.pytest.ini_options]\npython_files = "*.py"\n'
            pyproject.write_text(content)

            result = subprocess.run(['uv', 'add', '--dev', 'pytest', 'ruff'], cwd=self.dir, capture_output=True)
            if result.returncode != 0:
                raise RuntimeError(f'uv add failed: {result.stderr.decode()}')

        gitignore = self.dir / '.gitignore'
        if not gitignore.exists():
            download_gitignore('python', gitignore)

    def create(self, path: pathlib.Path) -> None:
        path.write_text(self.entry.source_template)
        print(f'created: {path}')
        if self.entry.test_template:
            test_path = self.test_path_for(path)
            test_path.write_text(self.entry.test_template)
            print(f'created: {test_path}')

    def run(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        return sh(['uv', 'run', 'python', str(path)], cwd=self.dir)

    def test(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        return sh(['uv', 'run', 'pytest', '-v', str(path)], cwd=self.dir)

    def check(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        return sh(['uv', 'run', 'ruff', 'check', str(path)], cwd=self.dir)


class NodeHandlerBase(LanguageHandler):
    def _pnpm_init(self) -> None:
        package_json = self.dir / 'package.json'
        if not package_json.exists():
            result = subprocess.run(['pnpm', 'init'], cwd=self.dir, capture_output=True)
            if result.returncode != 0:
                raise RuntimeError(f'pnpm init failed: {result.stderr.decode()}')
            print(f'initialized pnpm project: {self.dir}')

            data = json.loads(package_json.read_text())
            data['type'] = 'module'
            package_json.write_text(json.dumps(data, indent=2) + '\n')

        gitignore = self.dir / '.gitignore'
        if not gitignore.exists():
            download_gitignore(self.language, gitignore)

    def create(self, path: pathlib.Path) -> None:
        path.write_text(self.entry.source_template)
        print(f'created: {path}')
        if self.entry.test_template:
            test_path = self.test_path_for(path)
            test_path.write_text(self.entry.test_template)
            print(f'created: {test_path}')

    def run(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        return sh(['pnpm', 'exec', 'tsx', str(path)], cwd=self.dir)

    def test(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        return sh(['pnpm', 'exec', 'tsx', '--test', str(path)], cwd=self.dir)


class JsHandler(NodeHandlerBase):
    language = 'js'

    def init_project(self) -> None:
        self._pnpm_init()
        result = subprocess.run(['pnpm', 'list', 'tsx'], cwd=self.dir, capture_output=True)
        if result.returncode != 0:
            sh(['pnpm', 'add', '-D', 'tsx'], cwd=self.dir)

    def check(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        return sh(['node', '--check', str(path)])


class TsHandler(NodeHandlerBase):
    language = 'ts'

    def init_project(self) -> None:
        self._pnpm_init()
        result = subprocess.run(['pnpm', 'list', 'tsx'], cwd=self.dir, capture_output=True)
        if result.returncode != 0:
            sh(['pnpm', 'add', '-D', 'tsx', 'typescript', '@types/node'], cwd=self.dir)

        tsconfig = self.dir / 'tsconfig.json'
        if not tsconfig.exists():
            tsconfig.write_text(
                json.dumps(
                    {
                        'compilerOptions': {
                            'target': 'ES2022',
                            'module': 'ESNext',
                            'moduleResolution': 'Bundler',
                            'strict': True,
                            'esModuleInterop': True,
                            'skipLibCheck': True,
                            'noEmit': True,
                        }
                    },
                    indent=2,
                )
                + '\n'
            )
            print(f'created: {tsconfig}')

    def check(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        return sh(['pnpm', 'exec', 'tsc', '--noEmit', str(path)], cwd=self.dir)


class RustHandler(LanguageHandler):
    language = 'rust'

    def init_project(self) -> None:
        cargo_toml = self.dir / 'Cargo.toml'
        if not cargo_toml.exists():
            crate_name = self.dir.name.replace('-', '_')
            cargo_toml.write_text(f'[package]\nname = "{crate_name}"\nversion = "0.1.0"\nedition = "2021"\n')
            print(f'created: {cargo_toml}')

        gitignore = self.dir / '.gitignore'
        if not gitignore.exists():
            download_gitignore('rust', gitignore)

    def create(self, path: pathlib.Path) -> None:
        content = self.entry.source_template
        if self.entry.test_template:
            test_body = '\n'.join(f'    {line}' if line else '' for line in self.entry.test_template.splitlines())
            content = content.rstrip() + f'\n\n#[cfg(test)]\nmod tests {{\n    use super::*;\n\n{test_body}\n}}\n'
        path.write_text(content)
        print(f'created: {path}')
        self._register_bin(path)

    def _register_bin(self, path: pathlib.Path) -> None:
        cargo_toml = self.dir / 'Cargo.toml'
        entry = f'\n[[bin]]\nname = "{path.stem}"\npath = "{path.name}"\n'
        content = cargo_toml.read_text()
        if f'name = "{path.stem}"' not in content:
            cargo_toml.write_text(content.rstrip() + '\n' + entry)

    def run(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        return sh(['cargo', 'run', '--bin', path.stem], cwd=self.dir)

    def test(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        return sh(['cargo', 'test', '--bin', path.stem, '--', '--nocapture'], cwd=self.dir)

    def check(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        return sh(['cargo', 'check', '--bin', path.stem], cwd=self.dir)


class GoHandler(LanguageHandler):
    language = 'go'

    def init_project(self) -> None:
        go_mod = self.dir / 'go.mod'
        if not go_mod.exists():
            result = subprocess.run(['go', 'mod', 'init', self.dir.name], cwd=self.dir, capture_output=True)
            if result.returncode != 0:
                raise RuntimeError(f'go mod init failed: {result.stderr.decode()}')
            print(f'initialized go module: {self.dir}')

        gitignore = self.dir / '.gitignore'
        if not gitignore.exists():
            download_gitignore('go', gitignore)

    def create(self, path: pathlib.Path) -> None:
        path.write_text(self.entry.source_template)
        print(f'created: {path}')
        if self.entry.test_template:
            test_path = self.test_path_for(path)
            test_path.write_text(self.entry.test_template)
            print(f'created: {test_path}')

    def run(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        return sh(['go', 'run', path.name], cwd=self.dir)

    def test(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        files = [path.name]
        test_path = self.test_path_for(path)
        if test_path.exists():
            files.append(test_path.name)
        return sh(['go', 'test', '-v'] + files, cwd=self.dir)

    def check(self, path: pathlib.Path) -> subprocess.CompletedProcess:
        return sh(['go', 'vet', path.name], cwd=self.dir)


HANDLER_CLASSES: dict[str, type[LanguageHandler]] = {
    'python': PythonHandler,
    'js': JsHandler,
    'ts': TsHandler,
    'rust': RustHandler,
    'go': GoHandler,
}


def build_handlers(config: Config) -> dict[str, LanguageHandler]:
    handlers = {}
    for lang, entry in config.languages.items():
        handlers[lang] = HANDLER_CLASSES[lang](entry, config.dir_for(lang))
    return handlers


def language_for_extension(config: Config, suffix: str) -> typing.Optional[str]:
    for lang in config.languages:
        if EXTENSIONS[lang] == suffix:
            return lang
    return None


def resolve(config: Config, filename: str) -> tuple[str, pathlib.Path]:
    p = pathlib.Path(filename)
    if len(p.parts) != 1:
        raise ValueError(f"px uses a flat structure, pass just a filename, e.g. 'px run foo.rs' (got: {filename})")
    if p.stem and p.stem[0].isdigit():
        raise ValueError(f"filename cannot start with a digit: '{p.name}'")

    language = language_for_extension(config, p.suffix)
    if not language:
        raise ValueError(f"no language configured for extension '{p.suffix}' in {CONFIG_FILENAME}")

    return language, config.dir_for(language) / p.name


def require_config() -> Config:
    config_path = pathlib.Path.cwd() / CONFIG_FILENAME
    if not config_path.exists():
        print(f'error: no {CONFIG_FILENAME} found in the current directory.', file=sys.stderr)
        print('run `px init` to create one.', file=sys.stderr)
        sys.exit(1)
    try:
        return Config.load(pathlib.Path.cwd())
    except (ValueError, json.JSONDecodeError) as e:
        print(f'error: invalid {CONFIG_FILENAME}: {e}', file=sys.stderr)
        sys.exit(1)


def cmd_init() -> int:
    config_path = pathlib.Path.cwd() / CONFIG_FILENAME
    sample = Config.sample()

    if not config_path.exists():
        print(f'no {CONFIG_FILENAME} found in {pathlib.Path.cwd()}')
        print('sample config:')
        print(json.dumps(sample, indent=2))
        answer = input(f'create {config_path} with this sample? [y/N] ').strip().lower()
        if answer != 'y':
            print('aborted. create .px.json yourself and re-run `px init`.')
            return 1
        config_path.write_text(json.dumps(sample, indent=2) + '\n')
        print(f'created: {config_path}')

    try:
        config = Config.load(pathlib.Path.cwd())
    except ValueError as e:
        print(f'config error: {e}', file=sys.stderr)
        return 1

    handlers = build_handlers(config)
    had_error = False
    for lang, handler in handlers.items():
        handler.dir.mkdir(parents=True, exist_ok=True)
        print(f'created: {handler.dir}')
        try:
            handler.init_project()
        except FileNotFoundError as e:
            print(f'error initializing {lang}: required tool not found: {e.filename}', file=sys.stderr)
            had_error = True
        except RuntimeError as e:
            print(f'error initializing {lang}: {e}', file=sys.stderr)
            had_error = True

    return 1 if had_error else 0


def cmd_new(filename: str) -> int:
    config = require_config()
    try:
        language, path = resolve(config, filename)
    except ValueError as e:
        print(f'error: {e}', file=sys.stderr)
        return 1

    if path.exists():
        print(f'file already exists: {path}')
    else:
        handler = build_handlers(config)[language]
        handler.dir.mkdir(parents=True, exist_ok=True)
        handler.create(path)

    subprocess.run([config.editor, str(config.dir_for(language)), str(path)])
    return 0


def cmd_exec(filename: str, action: str) -> int:
    config = require_config()
    try:
        language, path = resolve(config, filename)
    except ValueError as e:
        print(f'error: {e}', file=sys.stderr)
        return 1

    if not path.exists():
        print(f'error: {path} does not exist. create it with `px new {filename}`', file=sys.stderr)
        return 1

    handler = build_handlers(config)[language]
    try:
        result = getattr(handler, action)(path)
    except FileNotFoundError as e:
        print(f'error: required tool not found: {e.filename}', file=sys.stderr)
        return 1
    return result.returncode


def cmd_ls() -> int:
    config = require_config()
    print(config.root)
    for lang, entry in config.languages.items():
        directory = config.dir_for(lang)
        if directory.exists():
            print(directory)
    return 0


def cmd_open(language: typing.Optional[str]) -> int:
    config = require_config()
    if language:
        if language not in config.languages:
            print(f'error: unsupported language {language}. Supported: {", ".join(config.languages)}', file=sys.stderr)
            return 1
        target = config.dir_for(language)
    else:
        target = config.root

    if not target.exists():
        print(f'error: folder does not exist: {target}', file=sys.stderr)
        return 1

    subprocess.run([config.editor, str(target)])
    return 0


def main() -> None:
    parser = argparse.ArgumentParser(
        description='flat, per-language project runner (python/js/ts/rust/go)',
        epilog=(
            'commands:\n'
            '  init          create .px.json (if missing) and set up each language dir\n'
            '  new <file>    create <file> from template, e.g. px new foo.rs\n'
            '  run <file>    execute a file\n'
            '  test <file>   run tests for a file\n'
            '  check <file>  syntax/type check a file\n'
            '  ls            list configured language directories\n'
            '  open [lang]   open the workspace or a language dir in the editor\n'
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest='command', required=True)

    subparsers.add_parser('init', help='create .px.json and set up language directories')

    new_parser = subparsers.add_parser('new', help='create a new file from template')
    new_parser.add_argument('file', help='filename, e.g. foo.rs')

    run_parser = subparsers.add_parser('run', help='execute a file')
    run_parser.add_argument('file')

    test_parser = subparsers.add_parser('test', help='run tests for a file')
    test_parser.add_argument('file')

    check_parser = subparsers.add_parser('check', help='syntax/type check a file')
    check_parser.add_argument('file')

    subparsers.add_parser('ls', help='list configured language directories')

    open_parser = subparsers.add_parser('open', help='open workspace or language dir in editor')
    open_parser.add_argument('language', nargs='?', help='python, js, ts, rust, or go')

    args = parser.parse_args()

    if args.command == 'init':
        code = cmd_init()
    elif args.command == 'new':
        code = cmd_new(args.file)
    elif args.command == 'run':
        code = cmd_exec(args.file, 'run')
    elif args.command == 'test':
        code = cmd_exec(args.file, 'test')
    elif args.command == 'check':
        code = cmd_exec(args.file, 'check')
    elif args.command == 'ls':
        code = cmd_ls()
    elif args.command == 'open':
        code = cmd_open(args.language)
    else:
        parser.print_help()
        code = 0

    sys.exit(code)


if __name__ == '__main__':
    main()
