# Migrated from .config/kitty/kitty.conf

font-family = BlexMono Nerd Font Mono
font-size = 15

# Dark theme. Kitty leaves these at its defaults; these values match the
# existing dark tab bar and light tab text more closely in Ghostty.
background = #000000
foreground = #ffffff
window-theme = dark
macos-titlebar-style = tabs
split-divider-color = #81a2be

shell-integration-features = no-cursor
cursor-style = block
selection-background = #cfcfcf

# ANSI palette
palette = 1=#ad0000
palette = 9=#c70000
palette = 2=#83a300
palette = 10=#9ec400
palette = 3=#e6c547
palette = 11=#f0c674
palette = 4=#81a2be
palette = 12=#81a2be
palette = 5=#81a2be
palette = 13=#81a2be
palette = 6=#b294bb
palette = 14=#b77ee0
palette = 7=#70c0ba
palette = 15=#54ced6

# Tabs
keybind = super+l=next_tab
keybind = super+h=previous_tab
keybind = super+t=new_tab
keybind = super+w=close_tab

# Splits
keybind = super+minus=new_split:down
keybind = super+backslash=new_split:right

# Split navigation
keybind = shift+up=goto_split:up
keybind = shift+left=goto_split:left
keybind = shift+right=goto_split:right
keybind = shift+down=goto_split:down

# Keep these shortcuts from reaching applications.
keybind = ctrl+shift+h=ignore
keybind = ctrl+shift+l=ignore
keybind = ctrl+shift+k=ignore
keybind = ctrl+shift+j=ignore

# Clear the screen and scrollback.
keybind = super+k=clear_screen

# Kitty's custom active/inactive tab colors, tab separator, and move_window
# bindings have no direct Ghostty configuration equivalent.
